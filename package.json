{
  "name": "envguard",
  "version": "1.0.0",
  "description": "Zero-config Git secret leaks detector, type validator, and .env.example synchronizer.",
  "author": "latryee",
  "license": "MIT",
  "homepage": "https://github.com/latryee/envguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latryee/envguard.git"
  },
  "bugs": {
    "url": "https://github.com/latryee/envguard/issues"
  },
  "keywords": [
    "env",
    "environment-variables",
    "dotenv",
    "secrets",
    "security",
    "type-validation",
    "git-hook",
    "pre-commit",
    "cli",
    "linter"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "envguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
