{
  "name": "@latryee/envguard",
  "version": "1.2.0",
  "description": "Zero-config Git secret leaks detector, type validator, and .env.example synchronizer.",
  "author": "latryee",
  "license": "MIT",
  "homepage": "https://github.com/latryee/envguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latryee/envguard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/latryee/envguard/issues"
  },
  "keywords": [
    "env",
    "environment-variables",
    "dotenv",
    "secrets",
    "security",
    "type-validation",
    "git-hook",
    "pre-commit",
    "cli",
    "linter"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": "./dist/register.js",
      "require": "./dist/register.cjs"
    }
  },
  "bin": {
    "envguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bench": "node scripts/benchmark.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
